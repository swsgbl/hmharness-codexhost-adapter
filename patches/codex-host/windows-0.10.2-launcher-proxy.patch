+#[cfg(target_os = "windows")]
+fn windows_controller_environment(
+    desktop_environment: &[(OsString, OsString)],
+    helper_proxy_environment: &[(OsString, OsString)],
+) -> Vec<(OsString, OsString)> {
+    let mut controller_environment = desktop_environment.to_vec();
+    controller_environment.extend_from_slice(helper_proxy_environment);
+    controller_environment
+}
+
+#[cfg(target_os = "windows")]
+fn windows_desktop_proxy_arguments(proxy_environment: &[(OsString, OsString)]) -> Vec<OsString> {
+    let value = |names: &[&str]| {
+        names.iter().find_map(|name| {
+            proxy_environment
+                .iter()
+                .find(|(candidate, _)| candidate == name)
+                .map(|(_, value)| value.to_string_lossy().into_owned())
+        })
+    };
+
+    let proxy = value(&["ALL_PROXY", "all_proxy"])
+        .or_else(|| value(&["HTTPS_PROXY", "https_proxy"]))
+        .or_else(|| value(&["HTTP_PROXY", "http_proxy"]))
+        .filter(|value| !value.is_empty());
+    let Some(proxy) = proxy else {
+        return Vec::new();
+    };
+
+    let mut arguments = vec![OsString::from(format!("--proxy-server={proxy}"))];
+    let mut bypass = value(&["NO_PROXY", "no_proxy"])
+        .map(|value| {
+            value
+                .split(',')
+                .map(str::trim)
+                .map(str::to_owned)
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    for host in ["<local>", "localhost", "127.0.0.1", "::1"] {
+        if !bypass.iter().any(|entry| entry.eq_ignore_ascii_case(host)) {
+            bypass.push(host.to_owned());
+        }
+    }
+    arguments.push(OsString::from(format!(
+        "--proxy-bypass-list={}",
+        bypass.join(";")
+    )));
+    arguments
+}
